{
  "name": "forum-manager-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peer-sovereign AI agent for grassroots community engagement on professional forums. Dual-model (Claude + local LoRA) drafting, Telegram-fabric collaboration, samovar/treenity-native.",
  "scripts": {
    "build": "pnpm --recursive --filter './packages/*' run build",
    "dev": "pnpm --recursive --filter './packages/*' run dev",
    "test": "pnpm --recursive --filter './packages/*' run test",
    "type-check": "pnpm --recursive --filter './packages/*' run type-check"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.23.0",
      "@types/node": "^20.0.0",
      "typescript": "^5.5.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@shustermandmitry/samovar",
        "@samovar/process-runtime",
        "@treenity/core",
        "@treenity/react"
      ]
    }
  }
}
