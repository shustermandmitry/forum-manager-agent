{
  "name": "@forum-manager-agent/scraper-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude-driven generator that emits new forum-plugins/<forum>/ packages from a forum URL. Inspects, fills declarative schema (or writes code-mode), scaffolds package + fixtures + tests.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "bin": {
    "forum-plugins-gen": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "echo 'Not implemented'",
    "test": "echo 'pending samovar-test wiring'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@shustermandmitry/samovar": "*",
    "@forum-manager-agent/llm-bridge": "workspace:*",
    "cheerio": "^1.0.0"
  }
}
